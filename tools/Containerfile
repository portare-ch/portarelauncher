# Native arm64 build with glibc 2.36, compatible with the device's newer glibc.
FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc libc6-dev make cmake pkg-config libdrm-dev python3 python3-yaml && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
